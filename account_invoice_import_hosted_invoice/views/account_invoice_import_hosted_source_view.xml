<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_import_hosted_source_form" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.form</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_process"
                        type="object"
                        string="Process"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'error')"
                    />
                    <button
                        name="action_open_mapping_wizard"
                        type="object"
                        string="Resolve Missing Mappings"
                        class="oe_highlight"
                        invisible="state != 'mapping_required'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(account.action_move_in_invoice_type)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not move_id"
                            context="{'default_move_type': 'in_invoice'}"
                        >
                            <field name="move_id" widget="statinfo" string="Bill" />
                        </button>
                    </div>
                    <group>
                        <field name="source_url" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="provider" />
                        <field name="partner_id" />
                    </group>
                    <group string="Invoice Data">
                        <field name="invoice_number" />
                        <field name="invoice_date" />
                        <field name="invoice_due_date" />
                        <field name="currency_id" />
                        <field name="amount_untaxed" />
                        <field name="amount_total" />
                    </group>
                    <group
                        string="Missing Mappings"
                        invisible="state != 'mapping_required'"
                    >
                        <field name="missing_mapping_info" nolabel="1" />
                    </group>
                    <group string="Error" invisible="state != 'error'">
                        <field name="error_message" nolabel="1" />
                    </group>
                    <field name="normalized_url" invisible="1" />
                    <field name="process_date" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_list" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.list</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="source_url" />
                <field name="provider" />
                <field name="partner_id" />
                <field name="invoice_number" />
                <field name="invoice_date" />
                <field name="amount_total" />
                <field name="move_id" />
                <field name="state" decoration-danger="state == 'error'"
                    decoration-warning="state == 'mapping_required'"
                    decoration-success="state == 'processed'" />
            </list>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_search" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.search</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_url" />
                <field name="partner_id" />
                <field name="invoice_number" />
                <filter name="mapping_required" string="Mapping Required"
                    domain="[('state', '=', 'mapping_required')]" />
                <filter name="error" string="Error" domain="[('state', '=', 'error')]" />
                <filter name="processed" string="Processed"
                    domain="[('state', '=', 'processed')]" />
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                    <filter name="group_provider" string="Provider"
                        context="{'group_by': 'provider'}" />
                    <filter name="group_partner" string="Supplier"
                        context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_action" model="ir.actions.act_window">
        <field name="name">Hosted Invoice Sources</field>
        <field name="res_model">account.invoice.import.hosted.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
