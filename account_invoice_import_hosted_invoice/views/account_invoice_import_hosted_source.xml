<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_invoice_import_hosted_source_tree" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.list</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'processed'" decoration-danger="state == 'error'">
                <field name="create_date" string="Submitted On" />
                <field name="partner_id" />
                <field name="provider" />
                <field name="source_url" />
                <field name="invoice_number" />
                <field name="move_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'processed'"
                    decoration-warning="state == 'duplicate'"
                    decoration-danger="state == 'error'"
                />
                <button name="action_process" string="Process" type="object" icon="fa-refresh" invisible="state not in ('draft', 'error')" />
            </list>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_form" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.form</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'error')"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,duplicate,error" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="partner_id" />
                            <field name="provider" />
                            <field name="source_url" />
                            <field name="normalized_url" readonly="1" />
                            <field name="source_url_hash" readonly="1" />
                        </group>
                        <group>
                            <field name="move_id" readonly="1" />
                            <field name="invoice_number" readonly="1" />
                            <field name="invoice_date" readonly="1" />
                            <field name="invoice_due_date" readonly="1" />
                            <field name="currency_id" readonly="1" />
                            <field name="amount_untaxed" readonly="1" />
                            <field name="amount_total" readonly="1" />
                            <field name="process_date" readonly="1" />
                        </group>
                    </group>
                    <group string="Log">
                        <field name="error_message" nolabel="1" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_search" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.source.search</field>
        <field name="model">account.invoice.import.hosted.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="source_url" />
                <field name="invoice_number" />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]" />
                <filter name="duplicate" string="Duplicate" domain="[('state', '=', 'duplicate')]" />
                <filter name="error" string="Error" domain="[('state', '=', 'error')]" />
                <group string="Group By" name="groupby">
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}" />
                    <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoice_import_hosted_source_action" model="ir.actions.act_window">
        <field name="name">Hosted Invoice Sources</field>
        <field name="res_model">account.invoice.import.hosted.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="account_invoice_import_hosted_root_menu"
        name="Hosted Vendor Bill Import"
        parent="account.menu_finance_configuration"
        sequence="105"
    />

    <menuitem
        id="account_invoice_import_hosted_submit_menu"
        parent="account_invoice_import_hosted_root_menu"
        action="account_invoice_import_hosted_submit_action"
        sequence="10"
    />

    <menuitem
        id="account_invoice_import_hosted_source_menu"
        parent="account_invoice_import_hosted_root_menu"
        action="account_invoice_import_hosted_source_action"
        sequence="20"
    />
</odoo>
