<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_import_hosted_product_mapping_form" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.product.mapping.form</field>
        <field name="model">account.invoice.import.hosted.product.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="provider" />
                        <field name="external_key" />
                        <field name="external_label" />
                        <field name="product_id" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_invoice_import_hosted_product_mapping_list" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.product.mapping.list</field>
        <field name="model">account.invoice.import.hosted.product.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="provider" />
                <field name="external_key" />
                <field name="external_label" />
                <field name="product_id" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="account_invoice_import_hosted_product_mapping_action" model="ir.actions.act_window">
        <field name="name">Hosted Invoice Product Mappings</field>
        <field name="res_model">account.invoice.import.hosted.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
