<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_import_hosted_submit_form" model="ir.ui.view">
        <field name="name">account.invoice.import.hosted.submit.form</field>
        <field name="model">account.invoice.import.hosted.submit</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="url_text" placeholder="https://invoices.withorb.com/view?token=...&#10;https://pay.stripe.com/invoice/acct_.../live_.../pdf?s=em" nolabel="1" />
                </group>
                <footer>
                    <button
                        name="action_submit_and_process"
                        type="object"
                        string="Submit and Process"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="account_invoice_import_hosted_submit_action" model="ir.actions.act_window">
        <field name="name">Import Hosted Invoices from Links</field>
        <field name="res_model">account.invoice.import.hosted.submit</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
